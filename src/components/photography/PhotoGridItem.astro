---
import {
  getImageSrcset,
  getPhotoAlt,
  getPhotoAnchorId,
  getPhotoDisplayMeta,
  getPhotoSearchTags,
  type PhotoEntry
} from '../../lib/photography';

interface Props {
  photo: PhotoEntry;
  href: string;
  withTagData?: boolean;
  /** `sizes` of the tile image (PhotoGrid owns the column layout). */
  sizes: string;
  loading?: 'eager' | 'lazy';
  fetchpriority?: 'high';
}

const { photo, href, withTagData = false, sizes, loading = 'lazy', fetchpriority } = Astro.props;
const meta = getPhotoDisplayMeta(photo);
// e.g. data-location="zurich" data-condition="rain blue-hour"; read by the filter on /photography/tags/.
const dataAttributes = withTagData
  ? Object.fromEntries(
      Object.entries(getPhotoSearchTags(photo)).map(([group, values]) => [`data-${group}`, values.join(' ')])
    )
  : {};
---

{/* id="photo-<slug>": the back link of a photo page returns here (photoGrid.ts marks the tile). */}
<li class="photo-grid-item" id={getPhotoAnchorId(photo)} {...dataAttributes}>
  <a class="photo-grid-link" href={href}>
    <img
      class="photo-grid-image"
      src={photo.data.image}
      srcset={getImageSrcset(photo.data.image, photo.data.width)}
      sizes={sizes}
      alt={getPhotoAlt(photo)}
      width={photo.data.width}
      height={photo.data.height}
      loading={loading}
      decoding="async"
      fetchpriority={fetchpriority}
    />
    <span class="photo-grid-caption">
      {meta.title ? <span class="photo-grid-title">{meta.title}</span> : null}
      <span>
        <span data-lang-inline="en">{meta.category}</span>
        <span data-lang-inline="zh">{meta.categoryZh}</span>
      </span>
      {meta.location ? <span>{meta.location}</span> : null}
    </span>
  </a>
</li>
