---
/**
 * Masonry grid of photo tiles (1 / 2 / 3 columns). Images carry a srcset of width variants with
 * `sizes` matching the grid columns. Unless `priority` is false, the first row loads eagerly and the
 * first tile with high fetch priority (it is usually the largest image of a gallery page); with
 * `priority` false (the landing page, whose hero is the main image) every tile loads lazily, so on
 * phones the tiles below the screen do not share the link with the hero.
 * Behaviour (Masonry, marking the photo just viewed on return): src/scripts/photography/photoGrid.ts.
 */
import PhotoGridItem from './PhotoGridItem.astro';
import './photography.css';
import { getPhotoHref, type PhotoEntry, type PhotoHref } from '../../lib/photography';

interface Props {
  photos: PhotoEntry[];
  emptyMessage?: string;
  /** URL of each tile inside the current gallery; defaults to the standalone photo page. */
  hrefFor?: PhotoHref;
  /** Adds `data-<group>` tag attributes to each tile for the client-side filter on /photography/tags/. */
  withTagData?: boolean;
  /** False when another image is the page's main image (the landing page hero): no tile is eager or high priority. */
  priority?: boolean;
}

const { photos, emptyMessage, hrefFor = getPhotoHref, withTagData = false, priority = true } = Astro.props;
/** Rendered tile width: 3 columns of the 840px content from 1024px, 2 columns from 768px, else 1. */
const tileSizes = '(min-width: 1024px) 264px, (min-width: 768px) calc(50vw - 44px), calc(100vw - 40px)';
/** Tiles of the first row, loaded without waiting for layout. */
const firstRow = 3;
---

{
  photos.length > 0 ? (
    <ul class="photo-grid" data-photo-grid>
      {photos.map((photo, index) => (
        <PhotoGridItem
          photo={photo}
          href={hrefFor(photo)}
          withTagData={withTagData}
          sizes={tileSizes}
          loading={priority && index < firstRow ? 'eager' : 'lazy'}
          fetchpriority={priority && index === 0 ? 'high' : undefined}
        />
      ))}
    </ul>
  ) : emptyMessage ? (
    <p class="photo-grid-empty">{emptyMessage}</p>
  ) : null
}

<script>
  import '../../scripts/photography/photoGrid';
</script>
