---
/**
 * Theme and language switches of the photography pages, rendered inside the site header. The stored
 * values are applied to <html> before the first paint by Head.astro (earlyPreferenceScript); CSS
 * draws the pressed state from those attributes, and the script below only saves clicks and keeps
 * `aria-pressed` in sync. Storage keys and attributes: src/lib/photographyPrefs.ts.
 */
import { photographyProfile } from '../../data/photography';
import './photography.css';

const { en, zh } = photographyProfile.landingCopy;
---

<div class="photography-preferences" role="group" aria-labelledby="photography-preferences-label">
  <span id="photography-preferences-label" class="visually-hidden">
    <span data-lang-inline="en">{en.controls.preferences}</span>
    <span data-lang-inline="zh">{zh.controls.preferences}</span>
  </span>
  <div class="photography-preference-group" role="group" aria-labelledby="photography-theme-label">
    <span id="photography-theme-label" class="visually-hidden">
      <span data-lang-inline="en">{en.controls.theme}</span>
      <span data-lang-inline="zh">{zh.controls.theme}</span>
    </span>
    <span class="photography-segmented">
      <button type="button" data-photography-theme-option="light" aria-pressed="true">
        <span data-lang-inline="en">{en.controls.light}</span>
        <span data-lang-inline="zh">{zh.controls.light}</span>
      </button>
      <button type="button" data-photography-theme-option="dark" aria-pressed="false">
        <span data-lang-inline="en">{en.controls.dark}</span>
        <span data-lang-inline="zh">{zh.controls.dark}</span>
      </button>
    </span>
  </div>

  <div class="photography-preference-group" role="group" aria-labelledby="photography-language-label">
    <span id="photography-language-label" class="visually-hidden">
      <span data-lang-inline="en">{en.controls.language}</span>
      <span data-lang-inline="zh">{zh.controls.language}</span>
    </span>
    <span class="photography-segmented">
      <button type="button" data-photography-lang-option="en" aria-pressed="true" lang="en">
        {en.controls.english}
      </button>
      <button type="button" data-photography-lang-option="zh" aria-pressed="false" lang="zh-CN">
        {zh.controls.chinese}
      </button>
    </span>
  </div>
</div>

<script>
  import '../../scripts/photography/preferences';
</script>
