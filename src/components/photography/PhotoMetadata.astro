---
import { getPhotoMetadataRows, getPhotoTitle, type PhotoEntry } from '../../lib/photography';

interface Props {
  photo: PhotoEntry;
  /** `id` of the title heading, which names the photo section (PhotoDetailView). */
  headingId?: string;
}

const { photo, headingId } = Astro.props;
const title = getPhotoTitle(photo);
// Each value links to its category or tag gallery, so a photo page is never a dead end.
const metadataRows = getPhotoMetadataRows(photo);
---

<div class="photo-metadata">
  {title ? <h1 id={headingId}>{title}</h1> : null}
  <dl class="metadata-list">
    {
      metadataRows.map((row) => (
        <div class="metadata-row" data-metadata={row.key}>
          <dt>
            <span data-lang-inline="en">{row.label.en}</span>
            <span data-lang-inline="zh">{row.label.zh}</span>
          </dt>
          <dd>
            {/* Kept on one line each: whitespace here would show before the commas. */}
            {row.values.map((value, index) => (
              <>{index > 0 ? ', ' : null}<a class="metadata-link" href={value.href}>{value.label.en === value.label.zh ? value.label.en : <><span data-lang-inline="en">{value.label.en}</span><span data-lang-inline="zh">{value.label.zh}</span></>}</a></>
            ))}
          </dd>
        </div>
      ))
    }
  </dl>
  {photo.data.note ? <p class="photo-note">{photo.data.note}</p> : null}
</div>
