---
import TodoText from '../TodoText.astro';
import { isPlaceholder } from '../../lib/placeholders';

interface EducationItem {
  institution: string;
  degree: string;
  major: string;
  period: string;
}

interface Props {
  items: EducationItem[];
}

const { items } = Astro.props;
// A placeholder major is left out of a production build (TodoText renders nothing there), with its comma.
const showMajor = (major: string) => major !== '' && !(import.meta.env.PROD && isPlaceholder(major));
---

<ol class="education-list">
  {
    items.map((item) => (
      <li>
        <div class="education-heading">
          <span class="education-institution">{item.institution}</span>
          <span class="education-period">{item.period}</span>
        </div>
        <span class="education-degree">
          {item.degree}{showMajor(item.major) ? <>, <TodoText text={item.major} /></> : null}
        </span>
      </li>
    ))
  }
</ol>
