---
// One project as in a publication list: a looping clip beside the title from 640 px (above it on phones), the author
// line and a row of quiet link chips (LinkChips.astro; a link without a target yet is a muted chip marked "soon"). The clip
// plays while in view (clipPlayback.ts) for at most PLAY_LOOPS loops, then rests on its last frame; pointing at the
// card or focusing one of its links plays it again (WCAG 2.2.2). Under reduced motion it shows its poster.
import LinkChips from '../LinkChips.astro';
import type { ProjectEntry } from '../../data/academic';
import { site } from '../../data/site';

interface Props {
  project: ProjectEntry;
}

const PLAY_LOOPS = 3;
const { project } = Astro.props;
const { media } = project;
const hasEqual = project.authors.some((author) => author.equal);
---


<article class="project-card" data-project-card>
  <a
    class="project-card-media"
    href={project.href}
    tabindex="-1"
    aria-hidden="true"
    style={`aspect-ratio: ${media.width} / ${media.height}`}
    data-play-unit=""
    data-play-loops={PLAY_LOOPS}
  >
    <video
      src={media.video}
      poster={media.poster}
      width={media.width}
      height={media.height}
      muted
      loop
      playsinline
      preload="none"
      data-reduced-motion="poster"
    ></video>
  </a>
  <div class="project-card-body">
    <h3 class="project-card-title">
      <a href={project.href}>{project.title}</a>
    </h3>
    <p class="project-card-authors">
      {
        project.authors.map((author, index) => {
          const last = index === project.authors.length - 1;
          const name = author.name === site.name ? <strong>{author.name}</strong> : <a href={author.href}>{author.name}</a>;
          // One line, so no space enters between a name, its mark and its comma. A name never breaks; the line
          // wraps only at the spaces after the commas.
          return (
            <>
              <span class="project-card-author">{name}{author.equal ? <sup aria-hidden="true">*</sup> : null}{author.equal ? <span class="visually-hidden"> (equal contribution)</span> : null}{last ? null : ','}</span>
              {last ? null : ' '}
            </>
          );
        })
      }
    </p>
    {hasEqual ? <p class="project-card-note" aria-hidden="true">*{project.equalNote}</p> : null}
    <LinkChips links={project.links} label={`${project.title} links`} />
  </div>
</article>

<script>
  import '../../scripts/clipPlayback';

  // Pointing at a card, or focusing one of its links, plays its clip again after its loops are used up.
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    for (const card of document.querySelectorAll<HTMLElement>('[data-project-card]')) {
      const unit = card.querySelector<HTMLElement>('[data-play-unit]');
      if (!unit) continue;
      const set = (on: boolean) => {
        unit.toggleAttribute('data-play-force', on);
        document.dispatchEvent(new CustomEvent('clips:refresh'));
      };
      card.addEventListener('pointerenter', () => set(true));
      card.addEventListener('pointerleave', () => set(card.contains(document.activeElement)));
      card.addEventListener('focusin', () => set(true));
      card.addEventListener('focusout', (event) => set(card.contains(event.relatedTarget as Node | null) || card.matches(':hover')));
    }
  }
</script>
