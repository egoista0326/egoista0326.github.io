---
// The interactive demo's stage. Before Start it plays a recorded long-horizon chain (the project video's showcase with
// its task ticker, a muted loop under the page's playback rules and the nav's pause), so a reader who never starts the
// demo still sees one; a centred "Start the live demo" pill sits on it, and a click anywhere on the stage also starts
// it. The iframe (about 20 MB with the physics engine, about 6 MB compressed) is created only on Start, in the same
// box. It stays invisible until the demo reports its first drawn frame ('dexgo-demo-ready', posted by its
// app/main.js); meanwhile the recording keeps playing and a quiet loading line with an indeterminate bar takes the
// pill's place; the recording then stops (held). If the demo cannot start (no WebGL 2, a failed download), it reports
// 'dexgo-demo-failed' with its sentence and the line shows it instead, over the recording dimmed to half; when the
// demo says a retry can help (a failed download, not a missing WebGL 2), the line also offers "Try again", which reloads
// the same iframe. After 60 s without either, the iframe is shown as it is.
// Keyboard focus moves into the demo only after a keyboard start; after a pointer start the loading line gives up its
// focus, so Space and the arrows keep scrolling the page.
// The page's own clips are suspended only while the demo simulates (it reports 'dexgo-demo-running' on every start and
// stop) and at least 60 % of the stage is in view. Under the stage, one line: "Open in a new tab" (no caption, owner).
//
// The demo lays itself out side by side only in a frame at least 780 px wide and wider than tall (its index.html). From
// an 864 px viewport the stage fills the 800 px column at the demo's 800 x 474 frame and the recording is drawn
// contained in it. In the stacked media (TALL_MEDIA, global.css) the stage first shows the phone cut of the recording
// with a 96 px band for the pill under it, and on Start it grows to the demo's 9:16 frame in 300 ms, anchored at its
// top (the content below moves down). Once the frame has its running size, the page then scrolls only as far as needed
// to show the running frame below the nav (its top never under the nav; a phone shows its controls, view and task
// graph, a landscape phone at least its controls and status), and only if the visitor has not scrolled since Start.
// That scroll never leaves a line of the part head above (eyebrow, headline) cut by the nav's bottom edge. After a
// width change (a rotation), a running demo that was in view is placed the same way again.
// The demo reports its hand and object with every model ('dexgo-demo-hand', {hand, first, object, firstObject}): the
// link opens /dexgo/demo/ with ?hand=<id> for another hand than the first of its hands.json and &object=<slug> for
// another object than the first of that hand's list; back on the first ones, /dexgo/demo/ again.
// The embedded demo starts with ?seed=47 (the curated opening, lead default 2026-11-22: its worker keeps that seed for
// the first 10 goals of Random chain, then re-seeds from crypto.getRandomValues); "Open in a new tab" stays unseeded.
// The nav's "Pause all motion" / "Play all motion" ('clips:paused', clipPlayback.ts) reaches a started demo as
// 'dexgo-pause' {paused}: a pause stops it, a play resumes it only if that pause stopped it (its app/main.js). Nothing
// is sent at Start, so a Start while the page's clips rest (a pause kept for this tab) still runs the demo.
import ClipVideo from './ClipVideo.astro';
import type { Clip } from '../../data/dexgo';

interface Props {
  /** Page embedded in the iframe, e.g. '/dexgo/demo/index.html' (served from public/). */
  src: string;
  /** Accessible iframe title. */
  title: string;
  startLabel: string;
  loadingLabel: string;
  newTabLabel: string;
  caption: string;
  /** The recorded chain for the side-by-side stage and its phone cut for the stacked stage. */
  preview: Clip;
  previewPhone: Clip;
}

const { src, title, startLabel, loadingLabel, newTabLabel, caption, preview, previewPhone } = Astro.props;
// Must match global.css (.dx-demo-stage): where the demo runs stacked in a 9:16 frame.
const TALL_MEDIA = '(max-width: 843px), (max-width: 863px) and (orientation: portrait)';
const newTabHref = src.replace(/index\.html$/, '');
---

<div class="dx-demo" data-demo-embed data-demo-src={src} data-demo-title={title} data-tall-media={TALL_MEDIA}>
  <div class="dx-demo-stage" data-demo-frame style={`--preview-phone-ratio: ${previewPhone.width} / ${previewPhone.height}`}>
    <div class="dx-demo-preview" data-demo-preview>
      <ClipVideo clip={preview} class="dx-demo-preview-wide" />
      <ClipVideo clip={previewPhone} class="dx-demo-preview-phone" />
    </div>
    <button type="button" class="dx-pill dx-pill-primary dx-demo-start" data-demo-start>
      <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true" focusable="false"><path d="M8 5.5v13l10.5-6.5z" /></svg>
      {startLabel}
    </button>
    <div class="dx-demo-loading" data-demo-loading role="status" tabindex="-1" hidden>
      <span data-demo-loading-text>{loadingLabel}</span>
      <span class="dx-demo-progress" aria-hidden="true"></span>
      <button type="button" class="dx-pill dx-demo-retry" data-demo-retry hidden>Try again</button>
    </div>
  </div>
  <p class="dx-note dx-demo-links">
    {caption ? <span class="dx-note-text">{caption}</span> : null}
    <a class="dx-link" href={newTabHref} target="_blank" rel="noopener" data-demo-newtab>{newTabLabel}<span aria-hidden="true">&nbsp;↗</span></a>
  </p>
</div>

<script>
  const REVEAL_FALLBACK_MS = 60000;
  // The curated opening (lead default 2026-11-22): the worker keeps seed 47 for the first 10 goals, then re-seeds.
  const OPENING_SEED = 47;
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const SUSPEND_RATIO = 0.6; // share of the stage in view above which a running demo suspends the page's clips

  for (const embed of document.querySelectorAll<HTMLElement>('[data-demo-embed]')) {
    const frame = embed.querySelector<HTMLElement>('[data-demo-frame]');
    const start = embed.querySelector<HTMLButtonElement>('[data-demo-start]');
    const loading = embed.querySelector<HTMLElement>('[data-demo-loading]');
    const loadingText = embed.querySelector<HTMLElement>('[data-demo-loading-text]');
    const newTab = embed.querySelector<HTMLAnchorElement>('[data-demo-newtab]');
    const retry = embed.querySelector<HTMLButtonElement>('[data-demo-retry]');
    if (!frame || !start || !loading || !loadingText) continue;
    const loadingDefault = loadingText.textContent ?? '';
    const newTabBase = newTab?.getAttribute('href') ?? '';
    const tall = window.matchMedia(embed.dataset.tallMedia ?? 'none');
    // The recording rests once the live demo shows (its units are held; clipPlayback.ts).
    const holdPreview = () => {
      for (const unit of embed.querySelectorAll<HTMLElement>('[data-demo-preview] [data-play-unit]')) unit.setAttribute('data-play-hold', '');
      document.dispatchEvent(new CustomEvent('clips:refresh'));
    };
    // Stacked stage: grow from the recording's height to the demo's 9:16 frame in 300 ms, anchored at the top; `then`
    // runs once, when the frame has its running size. Returns false when nothing animates (side by side, or stacked
    // under reduced motion, where .is-started sets the 9:16 frame at once).
    const grow = (then: () => void) => {
      if (!tall.matches || reducedMotion) return false;
      const from = frame.getBoundingClientRect().height;
      frame.style.height = `${from}px`;
      void frame.offsetHeight;
      frame.classList.add('is-growing');
      frame.style.height = `${(frame.getBoundingClientRect().width * 16) / 9}px`;
      let ended = false;
      const done = (event?: TransitionEvent) => {
        // only the stage's own height transition (the children's transitions bubble here too), or the timeout
        if (ended || (event && (event.target !== frame || event.propertyName !== 'height'))) return;
        ended = true;
        frame.removeEventListener('transitionend', done);
        frame.classList.remove('is-growing');
        frame.style.height = '';
        then();
      };
      frame.addEventListener('transitionend', done);
      window.setTimeout(done, 400);
      return true;
    };
    // The text lines of the part head above the stage (eyebrow, headline) as [top, bottom] in window px: the boxes of
    // their text and inline spans (a range over each element's contents), not the elements' block boxes.
    const headLines = () => {
      const lines: [number, number][] = [];
      const range = document.createRange();
      for (const el of embed.closest('[data-part]')?.querySelectorAll('.dx-part-head > *') ?? []) {
        range.selectNodeContents(el);
        for (const b of range.getClientRects()) if (b.height > 0) lines.push([b.top, b.bottom]);
      }
      return lines;
    };
    // The running frame (controls, view, task graph) on screen: its top below the sticky nav (nav bottom + 8 px), its
    // bottom pulled up to the window's bottom - 12 px without moving its top above that line; a frame already there
    // does not move (desktops). When the page does scroll, it never parks a line of the part head on the nav's bottom
    // edge (cut letters): the scroll dy is moved out of every such range (1 px clear), to the end where the line goes
    // wholly under the nav or to the one where it shows whole below it. Of those that keep the frame placed (top at nav
    // bottom + 8 px or lower and, where the frame fits the window, bottom 12 px above the window's bottom or higher)
    // the nearer one; if neither does, the first while the frame's top stays placed, else the second.
    const place = (behavior: ScrollBehavior) => {
      const navBottom = Math.max(0, document.querySelector('.dx-localnav')?.getBoundingClientRect().bottom ?? 0);
      const r = frame.getBoundingClientRect();
      const top = navBottom + 8;
      const most = r.top - top; // the largest scroll that keeps the frame's top at nav bottom + 8 px
      const fits = top + r.height + 12 <= window.innerHeight;
      let dy = 0;
      if (r.top < top) dy = most;
      else if (r.bottom + 12 > window.innerHeight) dy = Math.min(r.bottom + 12 - window.innerHeight, most);
      if (Math.abs(dy) < 1) return;
      const placed = (d: number) => d <= most + 0.5 && (!fits || r.bottom - d + 12 <= window.innerHeight + 0.5);
      // the scrolls that would cut a head line, (lineTop - navBottom, lineBottom - navBottom), merged where they meet
      // (a line's text box is taller than its line pitch, so the two lines of the headline merge)
      const cuts = headLines()
        .map(([t, b]) => [t - navBottom - 1, b - navBottom + 1])
        .sort((a, b) => a[0] - b[0]);
      for (let i = 0; i < cuts.length; i++) {
        let [lo, hi] = cuts[i];
        while (i + 1 < cuts.length && cuts[i + 1][0] < hi) hi = Math.max(hi, cuts[++i][1]);
        if (lo < dy && dy < hi) {
          const ends = [hi, lo].filter(placed).sort((a, b) => Math.abs(a - dy) - Math.abs(b - dy));
          dy = ends[0] ?? (hi <= most ? hi : lo);
          break;
        }
      }
      if (Math.abs(dy) >= 1) window.scrollBy({ top: dy, behavior });
    };
    // After a Start, once the frame has its running size. Not if the visitor has scrolled since the Start (they have
    // moved on).
    const fitRunning = (scrollAtStart: number) => {
      if (Math.abs(window.scrollY - scrollAtStart) > 4) return;
      place(reducedMotion ? 'auto' : 'smooth');
    };

    let started = false;
    const begin = (viaKeyboard: boolean) => {
      if (started) return;
      started = true;
      const iframe = document.createElement('iframe');
      iframe.title = embed.dataset.demoTitle ?? 'Interactive demo';
      iframe.allow = 'fullscreen';
      let fallback = 0;

      // Show the demo in place of the recording (first frame drawn, or the fallback). After a keyboard start, focus
      // follows it unless the visitor has moved on meanwhile: the demo is asked ('dexgo-focus') to put it, with a
      // visible ring, on its "Pause demo"; after a pointer start the loading line lets go of it.
      const reveal = () => {
        if (embed.classList.contains('is-loaded') || embed.classList.contains('is-failed')) return;
        window.clearTimeout(fallback);
        embed.classList.add('is-loaded');
        loading.hidden = true;
        holdPreview();
        const waiting = document.activeElement === loading || document.activeElement === document.body;
        if (viaKeyboard && waiting) {
          iframe.focus();
          iframe.contentWindow?.postMessage({ type: 'dexgo-focus' }, window.location.origin);
        } else if (document.activeElement === loading) loading.blur();
      };

      // Suspend the page's clips only while the demo runs and most of its stage is in view.
      let running = false;
      let inView = false;
      let suspended = false;
      const sync = () => {
        const on = running && inView;
        if (on === suspended) return;
        suspended = on;
        document.dispatchEvent(new CustomEvent(on ? 'clips:suspend' : 'clips:resume'));
      };

      // The nav's pause / play reaches the demo (it ignores a play after a pause of its own). Only on changes, never at
      // Start: the page's clips may start paused (a pause kept for this tab), and a Start must still run the demo. A change made
      // while the demo still loads is sent again once it shows (its listener may not have existed yet).
      let navPaused: boolean | null = null;
      const tellPause = () => {
        if (navPaused === null) return;
        iframe.contentWindow?.postMessage({ type: 'dexgo-pause', paused: navPaused }, window.location.origin);
      };
      document.addEventListener('clips:paused', (event) => {
        navPaused = (event as CustomEvent<{ paused?: boolean }>).detail?.paused === true;
        tellPause();
      });

      const onMessage = (event: MessageEvent) => {
        if (event.source !== iframe.contentWindow || event.origin !== window.location.origin) return;
        const data = event.data as {
          type?: string;
          message?: string;
          running?: boolean;
          hand?: string;
          first?: boolean;
          object?: string;
          firstObject?: boolean;
          retry?: boolean;
        } | null;
        if (data?.type === 'dexgo-demo-ready') {
          reveal();
          tellPause();
        } else if (data?.type === 'dexgo-demo-running') {
          running = data.running === true;
          sync();
        } else if (data?.type === 'dexgo-demo-hand' && newTab && typeof data.hand === 'string') {
          // "Open in a new tab" opens the hand and object the visitor chose (the first ones need no parameter)
          const query = new URLSearchParams();
          if (!data.first) query.set('hand', data.hand);
          if (!data.firstObject && typeof data.object === 'string' && data.object) query.set('object', data.object);
          const search = query.toString();
          newTab.href = search ? `${newTabBase}?${search}` : newTabBase;
        } else if (data?.type === 'dexgo-demo-failed') {
          // keep the recording: the line says that the demo could not start ("Open in a new tab" stays below); a
          // failed download (not a missing WebGL 2) also gets "Try again"
          window.clearTimeout(fallback);
          embed.classList.add('is-failed');
          loadingText.textContent = data.message || 'The demo could not load.';
          if (retry) retry.hidden = data.retry !== true;
          running = false;
          sync();
        }
      };
      window.addEventListener('message', onMessage);
      fallback = window.setTimeout(reveal, REVEAL_FALLBACK_MS);

      const url = new URL(embed.dataset.demoSrc ?? '', window.location.href);
      url.searchParams.set('seed', String(OPENING_SEED));
      const demoSrc = url.pathname + url.search;
      iframe.src = demoSrc;
      loading.hidden = false;
      let scrollAtStart = window.scrollY;
      const animating = grow(() => fitRunning(scrollAtStart));
      frame.append(iframe);
      embed.classList.add('is-started');
      start.hidden = true;
      loading.focus(); // the start button is gone: focus (and the screen reader) stay on the loading line
      scrollAtStart = window.scrollY; // that focus may itself have scrolled the loading line into view
      if (!animating) requestAnimationFrame(() => fitRunning(scrollAtStart));

      let seen = false; // at least 30 % of the stage in view
      new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            inView = entry.isIntersecting && entry.intersectionRatio >= SUSPEND_RATIO;
            seen = entry.isIntersecting && entry.intersectionRatio >= 0.3;
          }
          sync();
        },
        { threshold: [0, 0.3, SUSPEND_RATIO, 1] }
      ).observe(frame);

      // A width change (a rotation, or a window crossing the stacked / side-by-side breakpoint) changes the height of
      // everything above the stage while scrollY stays, which can leave the running frame off screen (where the demo
      // pauses itself). If the stage was in view before the change, place it again once the burst of resize events
      // has settled. Height-only changes (the phone's URL bar) do nothing; a stage the visitor had left stays left.
      let lastWidth = window.innerWidth;
      let keep = false;
      let settle = 0;
      window.addEventListener('resize', () => {
        if (window.innerWidth === lastWidth) return;
        if (!settle) keep = seen; // the state before this burst (resize events run before the observer updates)
        lastWidth = window.innerWidth;
        window.clearTimeout(settle);
        settle = window.setTimeout(() => {
          settle = 0;
          if (keep) requestAnimationFrame(() => place('auto'));
        }, 150);
      });

      // "Try again" after a failed download: the same iframe loads again (its WindowProxy, and so this page's message
      // listener, stay valid); the loading line and the 60 s fallback start over.
      retry?.addEventListener('click', (event) => {
        viaKeyboard = event.detail === 0;
        embed.classList.remove('is-failed');
        retry.hidden = true;
        loadingText.textContent = loadingDefault;
        loading.focus({ preventScroll: true }); // the button is gone: focus stays on the loading line
        window.clearTimeout(fallback);
        fallback = window.setTimeout(reveal, REVEAL_FALLBACK_MS);
        iframe.src = demoSrc; // setting src navigates even when the value is the same
      });
    };
    // A click with detail 0 comes from the keyboard (Enter / Space on the button).
    start.addEventListener('click', (event) => begin(event.detail === 0));
    // The recording is part of the target (pointer only; the button is the keyboard way in).
    frame.querySelector('[data-demo-preview]')?.addEventListener('click', () => begin(false));
  }
</script>
