---
// The paper's overview figure as a vector graphic. Three regions link to the subsections that explain
// them; the row of text links under the figure names them, in the order of those subsections, and is the
// visible affordance (no outlines at rest). Hovering or focusing a region or its link tints the region
// teal and underlines the link; the keyboard reaches the regions through the link row, so the regions are
// pointer targets only. Below 720 px the figure is too small to read: the regions are hidden, the whole
// image opens the full-size figure, and an "Open the figure" link says so.
interface Hotspot {
  target: string;
  label: string;
  /** [x, y, w, h] in the SVG's viewBox units. */
  rect: [number, number, number, number];
}

interface Props {
  src: string;
  width: number;
  height: number;
  alt: string;
  hotspots: Hotspot[];
  /** Text of the phone-only link to the full-size figure. */
  openLabel: string;
}

const { src, width, height, alt, hotspots, openLabel } = Astro.props;
const pct = (value: number, total: number) => `${((value / total) * 100).toFixed(3)}%`;
---

<figure class="dx-method-figure" data-method-figure>
  <div class="dx-method-stage" style={`aspect-ratio: ${width} / ${height}`}>
    <img src={src} alt={alt} width="1080" height={Math.round((1080 * height) / width)} decoding="async" loading="lazy" />
    <a class="dx-method-zoom" href={src} tabindex="-1" aria-hidden="true"></a>
    {
      hotspots.map((spot) => (
        <a
          class="dx-hotspot"
          href={`#${spot.target}`}
          aria-label={spot.label}
          tabindex="-1"
          aria-hidden="true"
          data-spot={spot.target}
          style={`left: ${pct(spot.rect[0], width)}; top: ${pct(spot.rect[1], height)}; width: ${pct(spot.rect[2], width)}; height: ${pct(spot.rect[3], height)}`}
        />
      ))
    }
  </div>
  <figcaption class="dx-spot-links">
    <a class="dx-method-open" href={src}>{openLabel}</a>
    {
      hotspots.map((spot) => (
        <a href={`#${spot.target}`} data-spot={spot.target}>
          {spot.label}
        </a>
      ))
    }
  </figcaption>
</figure>

<script>
  // Hovering or focusing a region or its link highlights both.
  for (const figure of document.querySelectorAll<HTMLElement>('[data-method-figure]')) {
    const all = [...figure.querySelectorAll<HTMLElement>('[data-spot]')];
    for (const el of all) {
      const mark = (on: boolean) => {
        for (const other of all) other.classList.toggle('is-lit', on && other.dataset.spot === el.dataset.spot);
      };
      el.addEventListener('pointerenter', () => mark(true));
      el.addEventListener('pointerleave', () => mark(false));
      el.addEventListener('focus', () => mark(true));
      el.addEventListener('blur', () => mark(false));
    }
  }
</script>
