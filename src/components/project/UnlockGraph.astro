---
// The prerequisite graph: the video's unlock animation (its file is cut to the graph, from the moment the graph
// has settled) plays once and rests on its last frame, where every task is learned. The nodes of that frame are
// buttons; the selected task's clip plays in its own column (under the graph below 864 px, where a selection
// scrolls it and its caption into view) with its unlock rule, and the task's prerequisites are ringed on the graph. While the page's videos
// are paused, the graph rests on its learned frame from the start, so the nodes are usable at once.
import type { Clip, GraphTask } from '../../data/dexgo';

interface Props {
  animation: Clip & { endPoster: string };
  tasks: GraphTask[];
  defaultTask: string;
  /** [x, y, w, h] of the state legend in frame pixels, covered once every task is learned. */
  legendRect: [number, number, number, number];
  /** Phones and from 864 px: the video's text below `top` (frame pixels), set as HTML: two-line captions per task id
      and the states. */
  phoneText: {
    top: number;
    captions: Record<string, [string, string]>;
    states: { id: string; label: string }[];
  };
  hint: string;
}

const { animation, tasks, defaultTask, legendRect, phoneText, hint } = Astro.props;
const W = animation.width;
const H = animation.height;
const pct = (value: number, total: number) => `${((value / total) * 100).toFixed(3)}%`;
const selected = tasks.find((task) => task.id === defaultTask) ?? tasks[0];
// The player keeps the clips' frame (one common crop for all 15 tasks).
const clipRatio = `${selected.clip.width} / ${selected.clip.height}`;
// Where the stacked layout's Replay button rises to once the legend is covered (global.css): its top 28 frame px
// under the legend band's top, as a share of the frame width (the graph's drawn width scales it).
const replayLift = ((H - (legendRect[1] + 28)) / W).toFixed(4);
---

{/* The hint sits above the graph from the first paint and stays (nothing moves after a selection). */}
<p class="dx-unlock-hint" data-unlock-hint>
  <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="10" /><path d="M10 8.2v7.6l6-3.8z" /></svg>
  {hint}
</p>
<div class="dx-unlock" data-unlock data-state="anim" data-end-poster={animation.endPoster} style={`--replay-lift: ${replayLift}`}>
  {/* The graph and, centred under it, the button that replays its unlocking. */}
  <div class="dx-unlock-main">
    <div class="dx-unlock-graph" style={`aspect-ratio: ${W} / ${H}; --cover-top: ${pct(phoneText.top, H)}`}>
      <div class="dx-unlock-anim" data-play-unit="once">
        <video muted playsinline preload="none" data-poster={animation.poster} width={W} height={H} aria-label={animation.label}>
          <source src={animation.src} type="video/mp4" />
        </video>
        {/* The learned end frame: a click during the unlocking cross-fades the graph to it in 200 ms (global.css). */}
        <img class="dx-unlock-endframe" src={animation.endPoster} alt="" width={W} height={H} loading="lazy" decoding="async" />
      </div>
      <div
        class="dx-unlock-legend-cover"
        style={`left: ${pct(legendRect[0], W)}; top: ${pct(legendRect[1], H)}; width: ${pct(legendRect[2], W)}; height: ${pct(legendRect[3], H)}`}
      >
      </div>
      {/* Phones and from 864 px (global.css): the video's captions and state legend, covered and set again at a
          readable size. They repeat text drawn in the video, so they are hidden from screen readers like it. */}
      <div class="dx-unlock-phone-cover"></div>
      <ul class="dx-unlock-captions" aria-hidden="true">
        {
          tasks
            .filter((task) => phoneText.captions[task.id])
            .map((task) => (
              <li style={`--x: ${pct(task.rect[0] + task.rect[2] / 2, W)}`}>
                {phoneText.captions[task.id][0]}
                <br />
                {phoneText.captions[task.id][1]}
              </li>
            ))
        }
      </ul>
      <ul class="dx-unlock-states" aria-hidden="true">
        {phoneText.states.map((state) => <li data-state-swatch={state.id}>{state.label}</li>)}
      </ul>
      {/* One Tab stop (roving tabindex): the selected task, or the last one focused while inside; arrow keys move,
          which each node's description says. */}
      <span id="unlock-keys" class="visually-hidden">Arrow keys move between tasks.</span>
      <div class="dx-unlock-nodes" role="group" aria-label="Tasks of the prerequisite graph">
        {
          tasks.map((task) => (
            <button
              type="button"
              class="dx-node"
              tabindex={task.id === selected.id ? 0 : -1}
              data-task={task.id}
              data-row={task.row}
              data-src={task.clip.src}
              data-poster={task.clip.poster}
              data-words={task.spoken}
              data-rule={task.rule}
              data-prerequisites={task.prerequisites.join(' ')}
              data-tip={`Play ${task.id}`}
              aria-pressed={task.id === selected.id ? 'true' : 'false'}
              aria-label={`Watch task ${task.id}: ${task.spoken}`}
              aria-describedby="unlock-keys"
              style={`left: ${pct(task.rect[0], W)}; top: ${pct(task.rect[1], H)}; width: ${pct(task.rect[2], W)}; height: ${pct(task.rect[3], H)}`}
            >
              <span class="dx-node-label">{task.id}</span>
              {/* Every node shows that it plays a clip, from the first frame; the tooltip names it (global.css). */}
              <span class="dx-node-play" aria-hidden="true"></span>
            </button>
          ))
        }
      </div>
    </div>
    <button type="button" class="dx-control" data-unlock-replay aria-label="Replay animation of the graph">Replay animation</button>
  </div>

  <div class="dx-unlock-side">
    <div
      class="dx-clip dx-unlock-clip"
      data-play-unit=""
      data-play-hold
      style={`aspect-ratio: ${clipRatio}`}
    >
      <video muted playsinline loop preload="none" data-poster={selected.clip.poster} width={selected.clip.width} height={selected.clip.height} aria-label={selected.clip.label}>
        <source src={selected.clip.src} type="video/mp4" />
      </video>
      {/* While the graph unlocks, the player shows the default task's poster with a play button (same as selecting
          that task); global.css shows it only in the "anim" state. */}
      <button type="button" class="dx-unlock-play" data-unlock-play aria-label={`Play ${selected.id}`}>
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false"><path d="M8 5.5v13l10.5-6.5z" /></svg>
      </button>
    </div>
    <p class="dx-unlock-caption" aria-live="polite">
      <span class="dx-unlock-task"><span data-unlock-code>{selected.id}</span>: <span data-unlock-words>{selected.spoken}</span></span>
      <span class="dx-unlock-rule" data-unlock-rule>{selected.rule}</span>
    </p>
  </div>
</div>

<script>
  import { isPaused } from '../../scripts/clipPlayback';

  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  // The stacked layout, where the player sits under the graph: global.css `.dx-unlock` is one column below its
  // `@media (min-width: 864px)` rule, which puts the player beside the graph.
  const stacked = window.matchMedia('(max-width: 863px)');
  // Space kept between the revealed clip / caption and the screen's edges, in CSS px.
  const revealMargin = 16;

  for (const root of document.querySelectorAll<HTMLElement>('[data-unlock]')) {
    const animUnit = root.querySelector<HTMLElement>('.dx-unlock-anim');
    const anim = animUnit?.querySelector('video');
    const clipUnit = root.querySelector<HTMLElement>('.dx-unlock-clip');
    const player = clipUnit?.querySelector('video');
    const replay = root.querySelector<HTMLButtonElement>('[data-unlock-replay]');
    const code = root.querySelector<HTMLElement>('[data-unlock-code]');
    const words = root.querySelector<HTMLElement>('[data-unlock-words]');
    const rule = root.querySelector<HTMLElement>('[data-unlock-rule]');
    const caption = root.querySelector<HTMLElement>('.dx-unlock-caption');
    const playButton = root.querySelector<HTMLButtonElement>('[data-unlock-play]');
    const nodes = [...root.querySelectorAll<HTMLButtonElement>('[data-task]')];
    if (!animUnit || !anim || !clipUnit || !player || !replay || !caption) continue;

    const refresh = () => document.dispatchEvent(new CustomEvent('clips:refresh'));
    // A click is an explicit request: that unit plays even where nothing autoplays or videos are paused.
    const force = (unit: HTMLElement) => unit.setAttribute('data-play-force', '');
    // Posters load lazily (clipPlayback copies `data-poster` near the viewport); before that, only the
    // pending value changes.
    const setPoster = (video: HTMLVideoElement, url: string) => {
      video.dataset.poster = url;
      if (video.hasAttribute('poster')) video.poster = url;
    };
    // "anim": the unlocking plays, the player waits. "explore": the graph rests on its learned frame.
    const setState = (state: 'anim' | 'explore') => {
      root.dataset.state = state;
      animUnit.toggleAttribute('data-play-hold', state === 'explore');
      clipUnit.toggleAttribute('data-play-hold', state !== 'explore');
      refresh();
    };

    const showEnd = () => {
      anim.pause();
      if (anim.readyState >= 1 && Number.isFinite(anim.duration)) {
        anim.currentTime = anim.duration;
      } else if (root.dataset.endPoster) {
        setPoster(anim, root.dataset.endPoster);
      }
    };

    // The initial selection is rendered on the server; only its prerequisite rings are set here.
    const markPrerequisites = (node: HTMLButtonElement) => {
      const prerequisites = (node.dataset.prerequisites ?? '').split(' ');
      for (const other of nodes) {
        other.setAttribute('aria-pressed', String(other === node));
        other.classList.toggle('is-prereq', prerequisites.includes(other.dataset.task ?? ''));
      }
    };

    const select = (node: HTMLButtonElement) => {
      markPrerequisites(node);
      if (code) code.textContent = node.dataset.task ?? '';
      if (words) words.textContent = node.dataset.words ?? '';
      if (rule) rule.textContent = node.dataset.rule ?? '';
      playButton?.setAttribute('aria-label', `Play ${node.dataset.task}`);
      const src = node.dataset.src ?? '';
      const current = player.currentSrc || player.getAttribute('src') || player.querySelector('source')?.getAttribute('src') || '';
      if (!current.endsWith(src)) {
        setPoster(player, node.dataset.poster ?? '');
        player.setAttribute('aria-label', `Example of task ${node.dataset.task}`);
        player.src = src;
      }
    };

    // Stacked layout: the clip and caption a visitor asked for open under the graph, often below the screen. Unless
    // the caption is already fully on screen (then the clip, between it and the tapped node, is too), scroll until
    // the caption ends `revealMargin` above the screen's bottom (measured after `select`, so the caption has its new
    // line count). Where node, clip and caption fit one screen the tapped node stays on it; where they do not (short
    // or landscape screens), the clip's top stops `revealMargin` under the screen's top instead.
    const revealPlayer = () => {
      if (!stacked.matches) return;
      const captionBottom = caption.getBoundingClientRect().bottom;
      if (captionBottom <= window.innerHeight) return;
      const clipTop = clipUnit.getBoundingClientRect().top;
      window.scrollBy({
        top: Math.min(captionBottom - (window.innerHeight - revealMargin), clipTop - revealMargin),
        behavior: reducedMotion ? 'auto' : 'smooth'
      });
    };

    for (const node of nodes) {
      // A user's selection (pointer, or Enter / Space on the button); the initial one is rendered on the server.
      node.addEventListener('click', () => {
        if (root.dataset.state === 'anim') {
          showEnd();
          setState('explore');
        }
        select(node);
        force(clipUnit);
        refresh();
        revealPlayer();
      });
    }

    // Keyboard: the graph is one Tab stop. Focus moves the stop to the focused node; leaving the graph gives it back
    // to the selected task. Left / Right move along a row, Up / Down to the nearest node (by centre) of the next row
    // (as in the demo's graph); Enter / Space select, as buttons do.
    const rows = new Map<number, HTMLButtonElement[]>();
    for (const node of nodes) {
      const row = Number(node.dataset.row);
      rows.set(row, [...(rows.get(row) ?? []), node]);
    }
    const setRover = (rover: HTMLButtonElement) => {
      for (const node of nodes) node.tabIndex = node === rover ? 0 : -1;
    };
    const centre = (node: HTMLButtonElement) => {
      const box = node.getBoundingClientRect();
      return box.left + box.width / 2;
    };
    for (const node of nodes) {
      node.addEventListener('focus', () => setRover(node));
      node.addEventListener('keydown', (event) => {
        const row = Number(node.dataset.row);
        const inRow = rows.get(row) ?? [];
        let next: HTMLButtonElement | undefined;
        if (event.key === 'ArrowLeft' || event.key === 'ArrowRight') {
          next = inRow[inRow.indexOf(node) + (event.key === 'ArrowLeft' ? -1 : 1)];
        } else if (event.key === 'ArrowUp' || event.key === 'ArrowDown') {
          const x = centre(node);
          next = (rows.get(row + (event.key === 'ArrowUp' ? -1 : 1)) ?? []).reduce<HTMLButtonElement | undefined>(
            (best, other) => (!best || Math.abs(centre(other) - x) < Math.abs(centre(best) - x) ? other : best),
            undefined
          );
        } else {
          return;
        }
        event.preventDefault(); // arrows never scroll the page from the graph
        next?.focus();
      });
    }
    root.querySelector('.dx-unlock-nodes')?.addEventListener('focusout', (event) => {
      const to = (event as FocusEvent).relatedTarget;
      if (to instanceof Node && nodes.some((node) => node === to)) return;
      const pressed = nodes.find((node) => node.getAttribute('aria-pressed') === 'true');
      if (pressed) setRover(pressed);
    });

    anim.addEventListener('ended', () => setState('explore'));
    // The player's play button during the unlocking (the first one and every replay) plays the selected task.
    playButton?.addEventListener('click', () => {
      (nodes.find((node) => node.getAttribute('aria-pressed') === 'true') ?? nodes[0])?.click();
    });

    replay.addEventListener('click', (event) => {
      // 640-863 px: the explore state lifts the button (global.css). A mouse click that starts the replay keeps it
      // there, under the pointer, until the pointer leaves it (data-replay-held), so it does not slide away.
      if (root.dataset.state === 'explore' && (event as PointerEvent).pointerType === 'mouse') {
        root.setAttribute('data-replay-held', '');
      }
      anim.currentTime = 0;
      force(animUnit);
      // The player waits on its frame again, with its play button (global.css shows it only without the force).
      clipUnit.removeAttribute('data-play-force');
      setState('anim');
    });
    replay.addEventListener('pointerleave', () => root.removeAttribute('data-replay-held'));

    const initial = nodes.find((node) => node.getAttribute('aria-pressed') === 'true');
    if (initial) markPrerequisites(initial);

    // Without autoplay (the page's videos paused), the graph rests on its learned frame so
    // the nodes can be used right away; pausing during the unlocking jumps there too (a replay asked for by
    // the user still plays).
    const toEnd = () => {
      showEnd();
      setState('explore');
    };
    if (isPaused()) toEnd();
    else setState('anim');
    document.addEventListener('clips:paused', (event) => {
      const { paused } = (event as CustomEvent<{ paused: boolean }>).detail;
      if (paused && root.dataset.state === 'anim' && !animUnit.hasAttribute('data-play-force')) toEnd();
    });
  }
</script>
