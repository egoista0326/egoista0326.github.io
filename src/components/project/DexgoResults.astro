---
import ClipVideo from './ClipVideo.astro';
import KeyHeading from './KeyHeading.astro';
import LazyDemo from './LazyDemo.astro';
import MediaNote from './MediaNote.astro';
import ObjectCarousel from './ObjectCarousel.astro';
import { dexgoPage } from '../../data/dexgo';

const { demo, targets, objects, sizes } = dexgoPage.results;
// Pairs: one common scale for both files (columns in proportion to their frame widths).
const pairColumns = `--pair-columns: ${targets.pair.map((clip) => `minmax(0, ${clip.width}fr)`).join(' ')}`;
// Sizes: one common scale k for the three files (see .dx-sizes in global.css). In source px: --span-sum, the
// summed drawn widths; --reach, the highest any file draws above its hand centre (the hand line); --below, the
// lowest object at rest under its hand centre (the label line); --h-max, the tallest file (caps k).
const sizeRow = [
  `--span-sum: ${sizes.clips.reduce((sum, clip) => sum + clip.right - clip.left, 0)}`,
  `--reach: ${Math.max(...sizes.clips.map((clip) => clip.handY - clip.top))}`,
  `--below: ${Math.max(...sizes.clips.map((clip) => clip.bottom - clip.handY))}`,
  `--h-max: ${Math.max(...sizes.clips.map((clip) => clip.height))}`
].join('; ');
---

<section class="dx-screen" aria-labelledby="results-demo">
  <KeyHeading id="results-demo" text={demo.heading} />
  <div class="dx-media">
    <LazyDemo
      src={demo.src}
      title={demo.title}
      startLabel={demo.startLabel}
      loadingLabel={demo.loadingLabel}
      newTabLabel={demo.newTabLabel}
      caption={demo.caption}
      poster={demo.poster}
      posterMid={demo.posterMid}
      posterPhone={demo.posterPhone}
      posterAlt={demo.posterAlt}
    />
  </div>
</section>

<section class="dx-screen" aria-labelledby="results-targets">
  <KeyHeading id="results-targets" text={targets.heading} />
  <div class="dx-media">
    <!-- Two pairs side by side (screwdriver left, hammer right, as in the video; stacked on phones); each loops on
         its own, since the two files differ in length. -->
    <div class="dx-pairs" style={pairColumns}>
      {targets.pair.map((clip) => <ClipVideo clip={clip} />)}
    </div>
    <MediaNote caption={targets.caption} />
  </div>
</section>

<section class="dx-screen" aria-labelledby="results-objects">
  <KeyHeading id="results-objects" text={objects.heading} />
  <div class="dx-hands" data-hand-switch>
    {
      objects.hands.length > 1 ? (
        <div class="dx-toggle" role="group" aria-label="Hand">
          {objects.hands.map((hand, index) => (
            <button type="button" data-hand-option={hand.id} aria-pressed={index === 0 ? 'true' : 'false'}>
              {hand.label}
            </button>
          ))}
        </div>
      ) : null
    }
    <div class="dx-media">
      {
        objects.hands.map((hand, index) => (
          <div class="dx-hand-panel" data-hand-panel={hand.id} hidden={index !== 0}>
            <ObjectCarousel items={hand.items} label={`Unseen everyday objects, ${hand.label}`} />
          </div>
        ))
      }
      {/* The notes share one cell that keeps its height, so switching hands never moves the page below. */}
      <div class="dx-hand-notes">
        {
          objects.hands.map((hand, index) =>
            hand.note ? (
              <p class="dx-note" data-hand-note={hand.id} aria-hidden={index !== 0 ? 'true' : undefined}>
                {hand.note}
              </p>
            ) : null
          )
        }
      </div>
    </div>
  </div>
</section>

<section class="dx-screen dx-screen-sizes" aria-labelledby="results-sizes">
  <KeyHeading id="results-sizes" text={sizes.heading} />
  <div class="dx-media">
    <!-- The three files hold the hand at one size; each is shown at its frame size times one common scale, so
         the hands match and the objects keep their relative sizes. As in the video, the hands sit on one line and
         the labels on one line under the objects; the long object's frame may hang over the labels (they stay in
         front) and its white top may lie under the heading's margin (the heading stays in front). Each figure is
         as wide as what its file draws; a larger frame lies under a smaller neighbour. -->
    <div class="dx-sizes" data-play-unit="" style={sizeRow}>
      {
        sizes.clips.map((clip, index) => (
          <figure
            class="dx-labelled"
            style={`--w: ${clip.width}; --hand-y: ${clip.handY}; --left: ${clip.left}; --span: ${clip.right - clip.left}; --z: ${sizes.clips.length - index}`}
          >
            <div class="dx-size-stage">
              <ClipVideo clip={clip} mode="row" />
            </div>
            <figcaption>{clip.name}</figcaption>
          </figure>
        ))
      }
    </div>
    <MediaNote caption={sizes.caption} />
  </div>
</section>

<script>
  // Hand switch: both panels keep the same cell positions; only one is shown.
  for (const root of document.querySelectorAll<HTMLElement>('[data-hand-switch]')) {
    const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-hand-option]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[data-hand-panel]')];
    const notes = [...root.querySelectorAll<HTMLElement>('[data-hand-note]')];
    for (const button of buttons) {
      button.addEventListener('click', () => {
        const hand = button.dataset.handOption;
        for (const b of buttons) b.setAttribute('aria-pressed', String(b === button));
        for (const panel of panels) panel.hidden = panel.dataset.handPanel !== hand;
        for (const note of notes) {
          if (note.dataset.handNote === hand) note.removeAttribute('aria-hidden');
          else note.setAttribute('aria-hidden', 'true');
        }
      });
    }
  }
</script>
