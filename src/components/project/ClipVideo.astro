---
import type { Clip } from '../../data/dexgo';

interface Props {
  clip: Clip;
  /**
   * Playback unit of clipPlayback.ts: 'loop' (own unit, loops), 'once' (own unit, plays once) or 'row'
   * (part of an enclosing looping row unit).
   */
  mode?: 'loop' | 'once' | 'row';
  class?: string;
}

const { clip, mode = 'loop', class: className } = Astro.props;
const unit = mode === 'row' ? undefined : mode === 'once' ? 'once' : '';
// Nothing loads with the page: the poster loads near the viewport (clipPlayback.ts copies `data-poster`), the clip about
// a screen ahead or once it is asked to play.
---

<div class:list={['dx-clip', className]} data-play-unit={unit} style={`--clip-aspect: ${clip.width} / ${clip.height}`}>
  <video
    muted
    playsinline
    loop={mode === 'loop' || mode === 'row'}
    preload="none"
    data-poster={clip.poster}
    width={clip.width}
    height={clip.height}
    aria-label={clip.label}
  >
    <source src={clip.src} type="video/mp4" />
  </video>
</div>

<script>
  import '../../scripts/clipPlayback';
</script>
