---
// A one-sentence heading as in the project video: phrases between *...* are drawn in the accent colour.
interface Props {
  text: string;
  level?: 2 | 3;
  id?: string;
}

const { text, level = 3, id } = Astro.props;
const Tag = level === 2 ? 'h2' : 'h3';
// Each part: whether it is a key phrase, and its pieces; odd pieces are hyphenated words ("Long-horizon"),
// kept on one line.
const parts = text.split('*').map((part, index) => ({ key: index % 2 === 1, pieces: part.split(/([A-Za-z]+(?:-[A-Za-z]+)+)/) }));
---

<Tag id={id} class="dx-heading">
  {
    parts.map(({ key, pieces }) => {
      const content = pieces.map((piece, i) => (i % 2 === 1 ? <span class="dx-nobr">{piece}</span> : piece));
      return key ? <span class="dx-key">{content}</span> : content;
    })
  }
</Tag>
