---
import Head from '../components/Head.astro';
import SiteHeader from '../components/SiteHeader.astro';
import PhotographyPreferences from '../components/photography/PhotographyPreferences.astro';
import { site } from '../data/site';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** Canonical URL path when it differs from this page's path (photo pages: `/photography/<slug>/`); `false` for none (404). */
  canonicalPath?: string | false;
  /** Class on <body> for page-scoped styles (e.g. 'page-dexgo', 'page-photo'). */
  bodyClass?: string;
  /** The page writes its own Open Graph / Twitter tags in the head slot; the generic ones are skipped. */
  ownShareTags?: boolean;
  /** og:image of the page (Head.astro). */
  shareImage?: { src: string; width: number; height: number; alt: string };
}

const { title, description, canonicalPath, bodyClass, ownShareTags = false, shareImage } = Astro.props;
// Every page gets the theme switch in the header and applies the stored theme before the first paint
// (Head.astro), so a theme chosen on one page holds on the others; photography pages also get the language
// switch (the other pages are English only).
const isPhotography = Astro.url.pathname.startsWith('/photography/');
---

<!doctype html>
<html lang="en">
  <head>
    <Head
      title={title}
      description={description}
      canonicalPath={canonicalPath}
      shareTags={!ownShareTags}
      photographyPreferences={isPhotography}
      shareImage={shareImage}
    />
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main">
      {
        isPhotography ? (
          <>
            <span data-lang-inline="en">Skip to content</span>
            <span data-lang-inline="zh">跳到正文</span>
          </>
        ) : (
          'Skip to content'
        )
      }
    </a>
    <div class="site-shell">
      <SiteHeader currentPath={Astro.url.pathname}>
        <PhotographyPreferences languages={isPhotography} />
      </SiteHeader>
      <main id="main" tabindex="-1">
        <slot />
      </main>
      <footer class="site-footer">
        <span>&copy; {new Date().getFullYear()} {site.name}</span>
        <a href={`mailto:${site.email}`}>{site.email}</a>
      </footer>
    </div>
  </body>
</html>
