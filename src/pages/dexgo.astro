---
import 'katex/dist/katex.min.css';
import ProjectLayout from '../layouts/ProjectLayout.astro';
import ClipVideo from '../components/project/ClipVideo.astro';
import DexgoResults from '../components/project/DexgoResults.astro';
import KeyHeading from '../components/project/KeyHeading.astro';
import LinkChips from '../components/LinkChips.astro';
import MediaNote from '../components/project/MediaNote.astro';
import MethodFigure from '../components/project/MethodFigure.astro';
import EncodingFigure from '../components/project/EncodingFigure.astro';
import ProblemFigure from '../components/project/ProblemFigure.astro';
import LazyDemo from '../components/project/LazyDemo.astro';
import UnlockGraph from '../components/project/UnlockGraph.astro';
import { dexgoPage as page } from '../data/dexgo';
import { isPlaceholder } from '../lib/placeholders';
import { texDisplay, texInline } from '../lib/tex';

const { method, problem } = page;
const { demo } = page.results;
// The figure's own props; `page` describes the separate figure page (src/pages/dexgo/figure.astro).
const { page: _figurePage, ...figure } = method.figure;
// Self-hosted web font: Source Sans 3 for all text (owner 2026-11-23, one family); global.css declares it. The
// abstract's one \emph phrase is its synthesized oblique. Preloaded: the title block and the abstract use it on the
// first screen, and a face that arrives after the first layout would reflow the abstract.
const fontPreloads = ['/fonts/source-sans-3/source-sans-3-latin-var.woff2'];
// A link shows once it has a target, or before that as a muted "soon" chip when marked so (Paper, Code).
const links = page.links.filter((link) => link.href || link.soon);
const hasEqual = page.authors.some((author) => author.equal);
// The co-first authors, then the others: each group wraps as a unit, so a narrow screen shows two lines of two.
const authorGroups = [page.authors.filter((author) => author.equal), page.authors.filter((author) => !author.equal)].filter(
  (group) => group.length > 0
);
const showBibtex = !isPlaceholder(page.bibtex) && page.bibtex.trim() !== '';
const pageUrl = new URL('/dexgo/', Astro.site).toString();
const shareImage = new URL(page.share.src, Astro.site).toString();
const shareTitle = `${page.title}: ${page.subtitle}`;
---

<ProjectLayout title={shareTitle} description={page.metaDescription} path="/dexgo/" iconDir="/dexgo/" bodyClass="page-dexgo" footer={`${page.title} · ${page.affiliation}`}>
  <Fragment slot="head">
    <meta name="theme-color" content="#ffffff" />
    <meta name="color-scheme" content="light" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={page.title} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:title" content={shareTitle} />
    <meta property="og:description" content={page.metaDescription} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content={String(page.share.width)} />
    <meta property="og:image:height" content={String(page.share.height)} />
    <meta property="og:image:alt" content={page.share.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={shareTitle} />
    <meta name="twitter:description" content={page.metaDescription} />
    <meta name="twitter:image" content={shareImage} />
    <meta name="twitter:image:alt" content={page.share.alt} />
    {fontPreloads.map((href) => <link rel="preload" as="font" type="font/woff2" href={href} crossorigin />)}
    <link rel="preload" as="image" href={page.teaser.poster} fetchpriority="high" media="(min-width: 640px)" />
    <link rel="preload" as="image" href={page.teaserPhone.poster} fetchpriority="high" media="(max-width: 639px)" />
  </Fragment>

  {/* Slim sticky in-page nav (no personal site name, icon or link: the page stays standalone). The current part is
      marked by the scrollspy below; the round button pauses and resumes every clip on the page (clipPlayback.ts). */}
  <nav slot="nav" class="dx-localnav" aria-label="DexGO sections">
    <div class="dx-localnav-inner">
      <a class="dx-localnav-name" href="#main">{page.title}</a>
      <ul class="dx-localnav-links">
        <li><a href="#method" data-nav="method">Method</a></li>
        <li><a href="#live-demo" data-nav="live-demo">Live demo</a></li>
        <li><a href="#results" data-nav="results">Results</a></li>
      </ul>
      <button type="button" class="dx-navpause" data-video-toggle data-toggle-icon aria-label="Pause all motion">
        <svg class="dx-icon-pause" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true" focusable="false"><path d="M7 5h3.2v14H7zM13.8 5H17v14h-3.2z" /></svg>
        <svg class="dx-icon-play" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true" focusable="false"><path d="M8 5.5v13l10.5-6.5z" /></svg>
      </button>
    </div>
  </nav>

  <article class="dx-page">
    <header class="dx-title">
      <h1>{page.title}</h1>
      <p class="dx-subtitle">{page.subtitle}</p>
      <p class="dx-authors">
        {authorGroups.map((group) => (
          <span class="dx-author-group">
            {group.map((author) => (
              <span class="dx-author"><a href={author.href}>{author.name}</a>{author.equal ? <sup aria-hidden="true">*</sup> : null}{author.equal ? <span class="visually-hidden"> (equal contribution)</span> : null}</span>
            ))}
          </span>
        ))}
      </p>
      <p class="dx-affiliation">{page.affiliation}</p>
      {hasEqual ? <p class="dx-author-note" aria-hidden="true">*{page.equalNote}</p> : null}
      {/* One pill style: the filled "Interactive demo" pill jumps to the Live demo part (and focuses its start button,
          script below); Paper and Code follow as outlined "soon" pills. */}
      <LinkChips links={links} label="Project links" class="dx-links">
        <a slot="lead" class="dx-pill dx-pill-primary" href={page.demoLink.href} data-demo-jump>
          <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false"><path d="M8 5.5v13l10.5-6.5z" /></svg>
          {page.demoLink.label}
        </a>
      </LinkChips>
    </header>

    {/* The teaser: the 2:1 cut, and below 640 px the 4:3 phone cut (global.css shows one; the hidden one never comes
        near the viewport, so it loads nothing). Muted loops; the nav's pause button covers them. */}
    <div class="dx-media dx-hero">
      <ClipVideo clip={page.teaser} class="dx-hero-wide" />
      <ClipVideo clip={page.teaserPhone} class="dx-hero-phone" />
    </div>

    <section class="dx-section dx-abstract" aria-labelledby="abstract-heading">
      <div class="dx-text" data-reveal>
        <h2 id="abstract-heading" class="dx-label">Abstract</h2>
        <p class="dx-prose" set:html={texInline(page.abstract)} />
      </div>
    </section>

    {/* Problem definition (owner 2026-11-23): what one goal is, between the abstract and the Method. A small section
        set like the abstract (eyebrow, 34 px heading, no hairline), not a fourth part: the nav lists three. */}
    <section id={problem.id} class="dx-section dx-problem" aria-labelledby="problem-heading">
      <header class="dx-problem-head" data-reveal>
        <p class="dx-eyebrow">{problem.eyebrow}</p>
        <KeyHeading id="problem-heading" level={2} text={problem.heading} />
      </header>
      <div class="dx-text" data-reveal>
        <p class="dx-prose" set:html={texInline(problem.text)} />
      </div>
      <div class="dx-media" data-reveal="media">
        <ProblemFigure {...problem.figure} />
      </div>
    </section>

    <section id="method" class="dx-part" aria-labelledby="method-overview" data-part>
      <header class="dx-part-head" data-reveal>
        <p class="dx-eyebrow">{method.eyebrow}</p>
        <KeyHeading id="method-overview" level={2} text={method.heading} />
      </header>
      <div class="dx-text" data-reveal>
        <p class="dx-prose" set:html={texInline(method.intro)} />
      </div>
      <div class="dx-media" data-reveal="media">
        <MethodFigure {...figure} />
      </div>

      <section class="dx-screen" aria-labelledby={method.graph.id}>
        <KeyHeading id={method.graph.id} text={method.graph.heading} />
        <div class="dx-text" data-reveal>
          <p class="dx-prose" set:html={texInline(method.graph.text)} />
        </div>
        <div class="dx-media">
          <UnlockGraph
            animation={method.graph.animation}
            tasks={method.graph.tasks}
            defaultTask={method.graph.defaultTask}
            legendRect={method.graph.legendRect}
            phoneText={method.graph.phoneText}
            hint={method.graph.hint}
          />
          <MediaNote caption={method.graph.legend} />
        </div>
      </section>

      <section class="dx-screen" aria-labelledby={method.kernel.id}>
        <KeyHeading id={method.kernel.id} text={method.kernel.heading} />
        <div class="dx-text" data-reveal>
          <p class="dx-prose" set:html={texInline(method.kernel.text)} />
        </div>
        <div class="dx-media" data-replay-scope>
          <ClipVideo clip={method.kernel.animation} mode="once" />
          <MediaNote caption={method.kernel.note}>
            <button type="button" class="dx-control" data-replay aria-label="Replay animation of the kernel">Replay animation</button>
          </MediaNote>
        </div>
      </section>

      <section class="dx-screen" aria-labelledby={method.encoding.id}>
        <KeyHeading id={method.encoding.id} text={method.encoding.heading} />
        <div class="dx-text" data-reveal>
          <p class="dx-prose" set:html={texInline(method.encoding.lead)} />
          <div class="dx-formula" set:html={texDisplay(method.encoding.formula)} />
          <p class="dx-prose" set:html={texInline(method.encoding.text)} />
        </div>
        <div class="dx-media" data-reveal="media">
          <EncodingFigure {...method.encoding.figure} />
        </div>
      </section>
    </section>

    {/* The one tinted part (owner 2026-11-23): a full-bleed light-grey band behind the whole Live demo part. */}
    <section id="live-demo" class="dx-part dx-part-band" aria-labelledby="results-demo" data-part>
      <header class="dx-part-head" data-reveal>
        <p class="dx-eyebrow">{demo.eyebrow}</p>
        <KeyHeading id="results-demo" level={2} text={demo.heading} />
      </header>
      <div class="dx-media" data-reveal="media">
        <LazyDemo
          src={demo.src}
          title={demo.title}
          startLabel={demo.startLabel}
          loadingLabel={demo.loadingLabel}
          newTabLabel={demo.newTabLabel}
          caption={demo.caption}
          preview={demo.preview}
          previewPhone={demo.previewPhone}
        />
      </div>
    </section>

    <section id="results" class="dx-part" aria-labelledby="results-targets" data-part>
      <DexgoResults />
    </section>

    {
      showBibtex ? (
        <section class="dx-section" aria-labelledby="bibtex-heading">
          <div class="dx-text">
            <h2 id="bibtex-heading" class="dx-label">
              BibTeX
            </h2>
            <pre class="dx-bibtex"><code>{page.bibtex}</code></pre>
          </div>
        </section>
      ) : null
    }
  </article>
</ProjectLayout>

<script>
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // "Interactive demo": scroll to the Live demo part (instantly under reduced motion) and put focus on its start
  // button without a second scroll, so Enter starts the demo. The band's top meets the nav where the whole stage
  // then fits on the screen; on shorter windows the page scrolls further, until the stage ends 16 px above the
  // window's bottom, so the focused start button (at the stage's bottom) is always in view.
  for (const link of document.querySelectorAll<HTMLAnchorElement>('[data-demo-jump]')) {
    link.addEventListener('click', (event) => {
      const target = document.querySelector<HTMLElement>(link.hash);
      if (!target) return;
      event.preventDefault();
      const nav = document.querySelector<HTMLElement>('.dx-localnav')?.offsetHeight ?? 0;
      const stage = target.querySelector<HTMLElement>('.dx-demo-stage');
      const headTop = target.getBoundingClientRect().top + window.scrollY - nav;
      const stageBottom = stage ? stage.getBoundingClientRect().bottom + window.scrollY + 16 : headTop;
      window.scrollTo({ top: Math.max(headTop, stageBottom - window.innerHeight), behavior: reducedMotion ? 'auto' : 'smooth' });
      history.replaceState(null, '', link.hash);
      target.querySelector<HTMLElement>('[data-demo-start]:not([hidden])')?.focus({ preventScroll: true });
    });
  }

  // Scrollspy: the nav marks the part that holds the line 40 % down the screen.
  const navLinks = new Map([...document.querySelectorAll<HTMLAnchorElement>('[data-nav]')].map((a) => [a.dataset.nav, a]));
  const parts = [...document.querySelectorAll<HTMLElement>('[data-part]')];
  const spy = () => {
    const line = window.innerHeight * 0.4;
    let current: string | undefined;
    for (const part of parts) if (part.getBoundingClientRect().top <= line) current = part.id;
    if (current && parts.find((p) => p.id === current)!.getBoundingClientRect().bottom < line) current = undefined;
    for (const [id, a] of navLinks) {
      if (id === current) a.setAttribute('aria-current', 'true');
      else a.removeAttribute('aria-current');
    }
  };
  let spyFrame = 0;
  window.addEventListener('scroll', () => {
    if (!spyFrame) spyFrame = requestAnimationFrame(() => ((spyFrame = 0), spy()));
  }, { passive: true });
  window.addEventListener('resize', spy);
  spy();

  // Reveal: part heads and section text fade up 16 px once, media only fades (global.css, [data-reveal]). Blocks
  // already on screen at load show at once; nothing hides without this script or under reduced motion.
  if (!reducedMotion && 'IntersectionObserver' in window) {
    const blocks = [...document.querySelectorAll<HTMLElement>('[data-reveal]')];
    const fold = window.innerHeight;
    const later = blocks.filter((el) => el.getBoundingClientRect().top > fold);
    for (const el of later) el.classList.add('is-pending');
    const reveal = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.remove('is-pending');
          reveal.unobserve(entry.target);
        }
      },
      { threshold: 0.15 }
    );
    for (const el of later) reveal.observe(el);
  }
</script>
