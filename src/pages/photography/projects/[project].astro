---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import PhotoGrid from '../../../components/photography/PhotoGrid.astro';
import { photographyProfile } from '../../../data/photography';
import { getPhotoLibrary, getProjectPhotoHref, type ProjectGallery } from '../../../lib/photography';

type Props = ProjectGallery;

export async function getStaticPaths() {
  const { projects } = await getPhotoLibrary();

  return projects.map(({ project, photos }) => ({
    params: { project: project.slug },
    props: { project, photos }
  }));
}

const { project, photos } = Astro.props;
const { landingCopy } = photographyProfile;
---

<SiteLayout title={`${project.title} | Photography`} description={project.summary}>
  <section class="photography-section gallery-heading" aria-labelledby="project-title">
    <p>
      <a class="photo-back-link" data-gallery-back href="/photography/#photography-projects-title">
        <span data-lang-inline="en">Back to Photography</span>
        <span data-lang-inline="zh">返回摄影</span>
      </a>
    </p>
    <p class="metadata-kicker">
      <span data-lang-inline="en">Photography Project</span>
      <span data-lang-inline="zh">摄影项目</span>
    </p>
    <h1 id="project-title">
      <span data-lang-inline="en">{project.title}</span>
      <span data-lang-inline="zh">{project.titleZh}</span>
    </h1>
    <dl class="project-detail-meta">
      <div>
        <dt>
          <span data-lang-inline="en">{landingCopy.en.copy.projectStart}</span>
          <span data-lang-inline="zh">{landingCopy.zh.copy.projectStart}</span>
        </dt>
        <dd>{project.startDate}</dd>
      </div>
    </dl>
    <p class="section-copy project-description">
      <span data-lang-inline="en">{project.description}</span>
      <span data-lang-inline="zh">{project.descriptionZh}</span>
    </p>
  </section>

  {/* Named "<page heading> photographs" in the page language. */}
  <section class="photography-section" aria-labelledby="project-title gallery-photos-word">
    <span id="gallery-photos-word" class="visually-hidden"><span data-lang-inline="en">photographs</span><span data-lang-inline="zh">照片</span></span>
    <PhotoGrid
      photos={photos}
      hrefFor={(photo) => getProjectPhotoHref(project.slug, photo)}
      emptyMessage="No photographs have been added to this project yet."
    />
  </section>

  <script>
    import '../../../scripts/photography/galleryBack';
  </script>
</SiteLayout>
