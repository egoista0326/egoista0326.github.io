---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import PhotoGrid from '../../../components/photography/PhotoGrid.astro';
import { getPhotoLibrary } from '../../../lib/photography';
import '../../../components/photography/tag-filter.css';

// All photos are rendered once; src/scripts/photography/tagFilterPage.ts hides those that do not
// match the checked options. Without JavaScript the form is a plain GET form and every photo shows.
const { photos, tagGroups } = await getPhotoLibrary();
const photographsEn = (count: number) => (count === 1 ? 'photograph' : 'photographs');
---

<SiteLayout title="Photography Tags" description="Browse photographs by controlled metadata tags.">
  <section class="photography-section gallery-heading" aria-labelledby="tags-title">
    <p>
      <a class="photo-back-link" data-gallery-back href="/photography/#tag-entry-title">
        <span data-lang-inline="en">Back to Photography</span>
        <span data-lang-inline="zh">返回摄影</span>
      </a>
    </p>
    <h1 id="tags-title">
      <span data-lang-inline="en">Photography Tags</span>
      <span data-lang-inline="zh">摄影标签</span>
    </h1>
    <p class="section-copy">
      <span data-lang-inline="en">Browse by location, camera, lens, and shooting conditions.</span>
      <span data-lang-inline="zh">按地点、相机、镜头和拍摄条件组合筛选照片。</span>
    </p>
  </section>

  {/* One box for controls, bar and results: the sticky bar stays inside it, at the bottom edge
      while the results are below the screen and at the top edge while they scroll by. */}
  <div class="tag-filter-page">
    <section class="tag-filter-panel" aria-labelledby="tag-filter-title">
      <div class="tag-filter-heading">
        <h2 id="tag-filter-title">
          <span data-lang-inline="en">Filters</span>
          <span data-lang-inline="zh">筛选</span>
        </h2>
        <p class="tag-filter-rule">
          <span data-lang-inline="en">Any ticked location, camera or lens matches; ticked conditions must all match.</span>
          <span data-lang-inline="zh">地点、相机、镜头任一即可；拍摄条件须全部满足。</span>
        </p>
      </div>
      <form
        id="tag-filter-form"
        class="tag-filter-form"
        method="get"
        action="/photography/tags/"
        data-tag-filter-form
      >
        {
          tagGroups.map((group) => (
            <fieldset class="tag-filter-group" data-filter-group={group.slug}>
              <legend>
                <span data-lang-inline="en">{group.label}</span>
                <span data-lang-inline="zh">{group.labelZh}</span>
              </legend>
              <div class="tag-filter-options">
                {group.tags.map((tag) => (
                  <label class="tag-filter-option">
                    <input type="checkbox" name={group.slug} value={tag.slug} />
                    <span class="tag-filter-option-label">{tag.label}</span>
                    <span class="tag-filter-option-count">
                      <span data-tag-option-count>{tag.count}</span>
                      <span class="visually-hidden">
                        <span data-lang-inline="en" data-tag-option-unit>
                          {photographsEn(tag.count)}
                        </span>
                        <span data-lang-inline="zh">张照片</span>
                      </span>
                    </span>
                  </label>
                ))}
              </div>
            </fieldset>
          ))
        }
        <noscript>
          <div class="tag-filter-nojs">
            <button class="tag-filter-button" type="submit">
              <span data-lang-inline="en">Apply filters</span>
              <span data-lang-inline="zh">应用筛选</span>
            </button>
            <p>
              <span data-lang-inline="en">Filtering needs JavaScript, so all photographs are shown below.</span>
              <span data-lang-inline="zh">筛选需要 JavaScript，因此下方显示全部照片。</span>
            </p>
          </div>
        </noscript>
      </form>
    </section>

    <div class="tag-filter-bar" data-tag-filter-bar>
      <p class="tag-filter-count" data-tag-result-count role="status" aria-live="polite">
        <span data-lang-inline="en">{photos.length} {photographsEn(photos.length)}</span>
        <span data-lang-inline="zh">{photos.length} 张照片</span>
      </p>
      <a class="tag-filter-show" href="#tag-results" data-tag-show-results>
        <span data-lang-inline="en">Show<span class="visually-hidden"> results</span></span>
        <span data-lang-inline="zh">查看<span class="visually-hidden">结果</span></span>
        <span aria-hidden="true">↓</span>
      </a>
      <button class="tag-filter-button" type="reset" form="tag-filter-form" data-tag-filter-clear>
        <span data-lang-inline="en">Clear filters</span>
        <span data-lang-inline="zh">清除筛选</span>
      </button>
    </div>

    <section id="tag-results" class="tag-search-results" aria-labelledby="tag-results-title" data-tag-results-section>
      <h2 id="tag-results-title" class="visually-hidden">
        <span data-lang-inline="en">Results</span>
        <span data-lang-inline="zh">结果</span>
      </h2>
      <div data-tag-search-results>
        <PhotoGrid photos={photos} withTagData emptyMessage="No photographs are available yet." />
      </div>
      <p class="photo-grid-empty" data-tag-empty hidden>
        <span data-lang-inline="en">No photographs match the selected filters.</span>
        <span data-lang-inline="zh">没有照片符合当前筛选条件。</span>
      </p>
    </section>
  </div>

  <script>
    import '../../../scripts/photography/tagFilterPage';
    import '../../../scripts/photography/galleryBack';
  </script>
</SiteLayout>
