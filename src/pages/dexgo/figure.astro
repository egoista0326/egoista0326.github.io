---
// The DexGO overview figure on its own page, for phones and tablets: on /dexgo/ it is a 350 px thumbnail whose labels
// are about 4 px tall, and the raw SVG opened directly is laid out in a 980 px viewport, so it is no larger. Here the
// page has the device width and the figure is drawn at `page.width` CSS px (labels with a cap height of about 11 px)
// inside a box that scrolls sideways; the page itself never scrolls sideways. Where the box is narrower than the
// figure, each side with more figure fades out and a round button on it scrolls the box (hidden at that end); on wide
// screens the whole figure shows with neither (a box of 900 px or more draws it at the box width, global.css). A standalone page like /dexgo/: no personal header, nav or footer; one
// link back to the figure's place on /dexgo/. Not indexed.
import ProjectLayout from '../../layouts/ProjectLayout.astro';
import { dexgoPage } from '../../data/dexgo';

const { figure } = dexgoPage.method;
const { page } = figure;
const height = Math.round((page.width * figure.height) / figure.width);
// Chevrons on a 24-unit grid (the carousel's).
const chevrons = [
  { dir: -1, label: 'Scroll the figure left', path: 'M15 5l-7 7 7 7' },
  { dir: 1, label: 'Scroll the figure right', path: 'M9 5l7 7-7 7' }
];
---

<ProjectLayout title={figure.label} description={dexgoPage.metaDescription} path="/dexgo/figure/" iconDir="/dexgo/" bodyClass="page-dexgo page-dexgo-figure">
  <Fragment slot="head">
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="color-scheme" content="light" />
  </Fragment>

  <h1 class="visually-hidden">{figure.label}</h1>
  <p class="dx-figure-back"><a class="dx-control" href={page.backHref}>{page.backLabel}</a></p>
  {/* The unmasked frame holds the buttons and draws the box's focus ring (the box's edge-fade mask would hide it). */}
  <div class="dx-figure-frame" data-figure-frame>
    <div class="dx-figure-scroll" tabindex="0" role="region" aria-label={`${figure.label}, scrolls sideways`} data-figure-scroll data-figure-label={figure.label}>
      <img src={figure.src} alt={figure.alt} width={page.width} height={height} decoding="async" />
    </div>
    {
      chevrons.map((chevron) => (
        <button type="button" class="dx-figure-more" data-figure-more={chevron.dir} aria-label={chevron.label} hidden>
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
            <path d={chevron.path} />
          </svg>
        </button>
      ))
    }
  </div>
</ProjectLayout>

<script>
  // Marks the sides of the box that have more figure (has-more-start / has-more-end: fade and button), on load,
  // scroll and resize. A button scrolls by 80 % of the box; at the end it hides, and if it had focus the other one
  // takes it, so keyboard focus is never lost.
  for (const frame of document.querySelectorAll<HTMLElement>('[data-figure-frame]')) {
    const box = frame.querySelector<HTMLElement>('[data-figure-scroll]');
    const buttons = [...frame.querySelectorAll<HTMLButtonElement>('[data-figure-more]')];
    if (!box) continue;
    const behavior: ScrollBehavior = window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth';

    const label = box.dataset.figureLabel ?? '';
    const update = () => {
      const max = box.scrollWidth - box.clientWidth;
      // A Tab stop (for the arrow keys) and the "scrolls sideways" name only while the figure overflows its box.
      if (max > 1) {
        box.tabIndex = 0;
        box.setAttribute('aria-label', `${label}, scrolls sideways`);
      } else {
        box.removeAttribute('tabindex');
        box.setAttribute('aria-label', label);
      }
      const more = { '-1': max > 1 && box.scrollLeft > 1, '1': max > 1 && box.scrollLeft < max - 1 };
      box.classList.toggle('has-more-start', more['-1']);
      box.classList.toggle('has-more-end', more['1']);
      for (const button of buttons) {
        const show = more[button.dataset.figureMore as '-1' | '1'];
        if (!show && document.activeElement === button) {
          buttons.find((other) => other !== button && !other.hidden)?.focus();
        }
        button.hidden = !show;
      }
    };

    for (const button of buttons) {
      button.addEventListener('click', () => {
        box.scrollBy({ left: Number(button.dataset.figureMore) * 0.8 * box.clientWidth, behavior });
      });
    }
    box.addEventListener('scroll', update, { passive: true });
    new ResizeObserver(update).observe(box);
    box.querySelector('img')?.addEventListener('load', update);
    update();
  }
</script>
